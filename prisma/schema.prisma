generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subcategory {
  id          String         @id @default(cuid())
  slug        String
  label       String
  category    MarketCategory
  description String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  markets     Market[]

  @@unique([slug, category])
  @@index([category])
  @@index([category, order])
}

model User {
  id                       String              @id @default(cuid())
  clerkId                  String              @unique
  username                 String              @unique
  displayName              String
  email                    String              @unique
  phoneVerified            Boolean             @default(false)
  avatarUrl                String?
  bio                      String?
  occupation               String?
  employer                 String?
  educationLevel           String?
  educationField           String?
  institution              String?
  certifications           String[]
  yearsExperience          Int?
  linkedinUrl              String?
  websiteUrl               String?
  stripeCustomerId         String?             @unique
  subscriptionTier         SubscriptionTier    @default(FREE)
  subscriptionStatus       SubscriptionStatus?
  isAdmin                  Boolean             @default(false)
  isSuspended              Boolean             @default(false)
  onboardingComplete       Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  hasSeenLanding           Boolean             @default(false)
  stripeAccountId          String?             @unique
  stripeOnboardingComplete Boolean             @default(false)
  accuracyScores           AccuracyScore[]
  comments                 Comment[]
  commentVotes             CommentVote[]
  competitions             Competition[]
  competitionsWon          Competition[]       @relation("CompetitionWinner")
  competitionMembers       CompetitionMember[]
  creatorSettings          CreatorSettings?
  topicsCreated            Market[]            @relation("topicCreator")
  payouts                  Payout[]
  predictions              Prediction[]
  predictionEdits          PredictionEdit[]
  subscribers              UserSubscription[]  @relation("expert")
  subscriptions            UserSubscription[]  @relation("subscriber")

  @@index([clerkId])
  @@index([username])
  @@index([subscriptionTier])
}

model Market {
  id                 String         @id @default(cuid())
  externalId         String?        @unique
  source             MarketSource
  category           MarketCategory
  title              String
  description        String?
  resolutionCriteria String?
  imageUrl           String?
  marketProbability  Float?
  closesAt           DateTime?
  resolvesAt         DateTime?
  resolvedAt         DateTime?
  status             MarketStatus   @default(OPEN)
  resolvedValue      Boolean?
  externalUrl        String?
  createdByUserId    String?
  topicStatus        TopicStatus?
  tags               String[]
  featured           Boolean        @default(false)
  viewCount          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subcategoryId      String?
  polymarketEventId  String?
  comments           Comment[]
  createdBy          User?          @relation("topicCreator", fields: [createdByUserId], references: [id])
  subcategory        Subcategory?   @relation(fields: [subcategoryId], references: [id], map: "Market_subcategoryId_Subcategory_id_fk")
  predictions        Prediction[]

  @@index([status])
  @@index([category])
  @@index([source])
  @@index([closesAt])
  @@index([featured])
  @@index([subcategoryId])
  @@index([polymarketEventId])
}

model Prediction {
  id               String           @id @default(cuid())
  userId           String
  marketId         String
  probability      Float
  reasoning        String
  reasoningSnippet String?
  status           PredictionStatus @default(ACTIVE)
  brierScore       Float?
  isCorrect        Boolean?
  lockedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  market           Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  edits            PredictionEdit[]

  @@unique([userId, marketId])
  @@index([userId])
  @@index([marketId])
  @@index([status])
  @@index([brierScore])
}

model PredictionEdit {
  id                  String     @id @default(cuid())
  predictionId        String
  userId              String
  previousProbability Float
  previousReasoning   String
  editReason          String?
  createdAt           DateTime   @default(now())
  prediction          Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([predictionId])
}

model Comment {
  id        String        @id @default(cuid())
  userId    String
  marketId  String
  parentId  String?
  body      String
  isDeleted Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  market    Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("replies", fields: [parentId], references: [id])
  replies   Comment[]     @relation("replies")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     CommentVote[]

  @@index([marketId])
  @@index([userId])
  @@index([parentId])
}

model CommentVote {
  id        String  @id @default(cuid())
  userId    String
  commentId String
  value     Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model AccuracyScore {
  id                String          @id @default(cuid())
  userId            String
  category          MarketCategory?
  totalPredictions  Int             @default(0)
  scoredPredictions Int             @default(0)
  totalBrierScore   Float           @default(0)
  avgBrierScore     Float?
  accuracyPct       Float?
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@index([category, avgBrierScore])
}

model CreatorSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  monthlyPriceCents Int      @default(999)
  platformFeeBps    Int      @default(1500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payout {
  id               String       @id @default(cuid())
  userId           String
  amountCents      Int
  stripeTransferId String?      @unique
  status           PayoutStatus @default(PENDING)
  requestedAt      DateTime     @default(now())
  processedAt      DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model UserSubscription {
  id                   String             @id @default(cuid())
  subscriberId         String
  expertId             String
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  monthlyPriceCents    Int
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  platformFeeBps       Int                @default(1500)
  expert               User               @relation("expert", fields: [expertId], references: [id], onDelete: Cascade)
  subscriber           User               @relation("subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, expertId])
  @@index([expertId])
  @@index([subscriberId])
}

model PlatformSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  tier                 SubscriptionTier
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model FeatureFlag {
  id          String     @id @default(cuid())
  key         FeatureKey @unique
  label       String
  description String
  isFree      Boolean    @default(false)
  isEnabled   Boolean    @default(true)
  updatedAt   DateTime   @updatedAt
  updatedBy   String?
}

model Competition {
  id               String              @id @default(cuid())
  name             String
  description      String?
  startsAt         DateTime
  endsAt           DateTime
  isPublic         Boolean             @default(true)
  entryCode        String?
  prizeDescription String?
  prizeImageUrl    String?
  maxParticipants  Int?
  participantCount Int                 @default(0)
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  winnerId         String?
  creator          User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  winner           User?               @relation("CompetitionWinner", fields: [winnerId], references: [id])
  members          CompetitionMember[]

  @@index([isPublic])
  @@index([startsAt])
  @@index([endsAt])
}

model CompetitionMember {
  id                String      @id @default(cuid())
  competitionId     String
  userId            String
  totalPredictions  Int         @default(0)
  scoredPredictions Int         @default(0)
  totalBrierScore   Float       @default(0)
  avgBrierScore     Float?
  joinedAt          DateTime    @default(now())
  competition       Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
  @@index([userId])
  @@index([avgBrierScore])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
}

enum MarketSource {
  POLYMARKET
  KALSHI
  METACULUS
  USER_CREATED
}

enum MarketCategory {
  POLITICS
  FINANCE
  CRYPTO
  SPORTS
  SCIENCE
  TECH
  ECONOMY
  OTHER
  GEOPOLITICS
  IRAN
  CULTURE
  WEATHER
  ELECTIONS
}

enum TopicStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PredictionStatus {
  ACTIVE
  LOCKED
  SCORED
}

enum SubscriptionTier {
  FREE
  STANDARD
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

enum FeatureKey {
  FULL_REASONING
  ACCURACY_FILTER
  USER_FILTER
  CATEGORY_LEADERBOARD
  EXPERT_QA
  TOPIC_CREATE
  PREDICT_SUBMIT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
